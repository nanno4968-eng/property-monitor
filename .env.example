# ------------------------------------------------------------------
# Distressed Property Monitor - environment configuration
# Copy to .env for local runs, or set as GitHub Actions repo secrets
# for the scheduled workflow. Everything below has a $0 option.
# ------------------------------------------------------------------

APP_ENV=development
DEFAULT_TIMEZONE=Africa/Johannesburg

# SQLite lives inside the repo's data/ folder - no database hosting cost.
DATABASE_URL=sqlite:///data/property_monitor.db

# Where inbound notices (PDF/TXT) are dropped for the manual-upload collector.
INBOX_DIR=data/inbox
RAW_DOCUMENT_ARCHIVE_DIR=data/raw_documents

MAX_UPLOAD_MB=25

# --- Email report (free-tier SMTP options) ---
# Brevo (ex-Sendinblue) free tier: 300 emails/day, no credit card: https://www.brevo.com
# Gmail also works with an "app password" for low volume, personal use.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alerts@example.org
ALERT_EMAIL_TO=you@example.org

# Only email when there's something worth seeing (recommended, keeps inbox quiet).
ALERT_MIN_OPPORTUNITY_SCORE=0
ALWAYS_SEND_DIGEST=false

# --- Geocoding (optional, free) ---
# OpenStreetMap Nominatim is free but rate-limited to ~1 req/sec and requires
# a descriptive user agent. Leave disabled if you don't need the map fields yet.
GEOCODING_ENABLED=false
GEOCODING_USER_AGENT=distressed-property-monitor (contact: you@example.org)

# --- Risk engine tuning ---
AUCTION_SOON_THRESHOLD_DAYS=7
SOURCE_STALE_THRESHOLD_DAYS=30
